server {
    listen 80;
    root /usr/share/nginx/html;

    # Tender PDFs and product sheets are uploaded through /api.
    client_max_body_size 200m;

    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        # Keep the connection to the API open and stream responses through as they arrive. With nginx's default
        # ("Connection: close" plus buffering to a temp file), Azure Container Apps' internal ingress cut large
        # responses such as a full estimate (~1.8 MB) short: "upstream prematurely closed connection".
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Pricing a full tender and filling the PDF can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Client-side routes (/experience, /bid, …) all load the app.
    location / {
        try_files $uri /index.html;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
